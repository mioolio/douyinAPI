# ============================
# 排除整个子项目（不推送到本仓库）
# ============================
airi-main/
HiLib/

# ============================
# 敏感数据：个人数据 / API Key / Cookie / 账号
# ============================

# ai-server 配置文件（含 DeepSeek API Key）
ai-server/config.json

# ai-server 用户对话数据（按日期存档、session、注入的上下文）
ai-server/data/

# ai-server 训练数据（含真人聊天记录分析）
ai-server/training/training.json

# ai-server 临时 cookie 文件
ai-server/1

# SPRR 所有运行时数据（账号、cookie、白名单、回复记录、浏览器配置、ticket-guard）
SPRR/data/

# ============================
# 日志
# ============================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
creator.douyin.com-*.log
新建 文本文档.txt
tmp-cookie-state.json

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov
.nyc_output/

# Dependency directories
node_modules/
jspm_packages/
web_modules/

# Compiled binary addons
build/Release

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm/
.eslintcache
.stylelintcache
.node_repl_history

# Output of 'npm pack'
*.tgz
.yarn-integrity

# parcel-bundler cache
.cache
.parcel-cache

# Next.js build output
.next/
out/

# Nuxt.js build / generate output
.nuxt/
dist/
.output/

# vitepress build output
**/.vitepress/dist
**/.vitepress/cache

# Sveltekit cache directory
.svelte-kit/

# dotenv environment variable files
.env
.env.*
!.env.example

# vuepress build output
.vuepress/dist
.temp/

# Docusaurus cache and generated files
.docusaurus/

# Serverless directories
.serverless/
.fusebox/
.dynamodb/
.firebase/

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# pnpm
.pnpm-store
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

